<?xml version="1.0" encoding="utf-8"?>
<!-- Reminders and amounts are personal data: nothing leaves the device by backup or transfer. Backup is an explicit,
     user-chosen export (Phase 2 and 10). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
